{
  "name": "@rsrsai/pi",
  "version": "0.1.11",
  "description": "Native Respire memory extension for Pi coding agent",
  "type": "module",
  "license": "MIT",
  "author": "risense-ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/risense-ai/respire-pi.git"
  },
  "homepage": "https://github.com/risense-ai/respire-pi#readme",
  "keywords": [
    "pi-package",
    "respire",
    "memory"
  ],
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./lib/index.js"
    ]
  },
  "files": [
    "lib",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/memory.js && node --check lib/rsrs.js && node --check lib/wrap-up.js",
    "behavior": "node scripts/behavior-check.js && node scripts/wrap-up-check.js",
    "verify:package": "node scripts/check-package.js",
    "release:package": "node scripts/release.js"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
